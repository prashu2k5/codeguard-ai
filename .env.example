# .env.example — copy this to .env and fill in your keys
#
# The Code Health scanner will load this file automatically on startup
# (requires: pip install python-dotenv).
#
# Without OPENAI_API_KEY the AI investigation endpoint uses a static
# heuristic fallback that clearly identifies itself as fallback mode.

# OpenAI API key — required for real AI-powered bug investigation
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...
